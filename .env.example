# Required for Google Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Cesium World Terrain access token.
VITE_CESIUM_ION_ACCESS_TOKEN=

# Optional DEM endpoint override. The default uses OpenTopoData ASTER30m.
# In local development, /api/elevation is proxied by Vite to this provider.
VITE_DEM_ENDPOINT=
